generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model RoomType {
  id                            String                         @id @default(uuid())
  name                          String
  description                   String
  capacity                      Int
  maxGuests                     Int                            @default(3)
  inventoryFor4Guests           Int                            @default(0)
  includedAdults                Int                            @default(2)
  totalUnits                    Int                            @default(1)
  basePrice                     Decimal
  extraAdultFee                 Decimal                        @default(0)
  child6To11Fee                 Decimal                        @default(0)
  amenities                     String
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  externalId                    String?
  bookings                      Booking[]
  fourGuestInventoryAdjustments FourGuestInventoryAdjustment[]
  inventory                     InventoryAdjustment[]
  photos                        Photo[]
  rates                         Rate[]
}

model Photo {
  id         String   @id @default(uuid())
  url        String
  position   Int      @default(0)
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
}

model Rate {
  id         String   @id @default(uuid())
  roomTypeId String
  startDate  DateTime
  endDate    DateTime
  price      Decimal
  cta        Boolean  @default(false)
  ctd        Boolean  @default(false)
  stopSell   Boolean  @default(false)
  minLos     Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, startDate, endDate])
}

model InventoryAdjustment {
  id                  String    @id @default(uuid())
  roomTypeId          String
  date                DateTime
  dateKey             String
  totalUnits          Int
  occupiedUnits       Int       @default(0)
  hospedinUnits       Int?
  manualOverrideUnits Int?
  hospedinSyncedAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  roomType            RoomType  @relation(fields: [roomTypeId], references: [id])

  @@unique([roomTypeId, dateKey])
  @@index([dateKey])
}

model FourGuestInventoryAdjustment {
  id         String   @id @default(uuid())
  roomTypeId String
  date       DateTime
  dateKey    String
  totalUnits Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  @@unique([roomTypeId, dateKey])
  @@index([dateKey])
}

model Guest {
  id        String    @id @default(uuid())
  name      String
  email     String
  phone     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Booking {
  id                      String            @id @default(uuid())
  guestId                 String
  roomTypeId              String
  adults                  Int               @default(1)
  children                Int               @default(0)
  childrenAges            String?
  pets                    Int               @default(0)
  checkIn                 DateTime
  checkOut                DateTime
  totalPrice              Decimal
  subtotalPrice           Decimal?
  discountAmount          Decimal?
  appliedCouponCode       String?
  promotionId             String?
  promotionName           String?
  promotionDiscount       Decimal?
  // JSON [{id,name,badgeLabel,discountPercent,discountAmount}] das promoções aplicadas (pode ser mais de uma).
  promotionBreakdown      String?
  status                  String
  funnelStage             String?
  funnelUpdatedAt         DateTime?
  lastErrorMessage        String?
  pendingEmailSentAt      DateTime?
  expiredEmailSentAt      DateTime?
  // Prazo para pagar (null = createdAt + PENDING_BOOKING_PAYMENT_WINDOW_MINUTES). O admin renova ao gerar link.
  paymentDeadlineAt       DateTime?
  confirmationEmailSentAt DateTime?
  checkoutConfirmedAt     DateTime?
  hospedinReservationId   String?
  hospedinRegisteredAt    DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  roomType                RoomType          @relation(fields: [roomTypeId], references: [id])
  guest                   Guest             @relation(fields: [guestId], references: [id])
  couponRedemption        CouponRedemption?
  issuedCoupons           Coupon[]          @relation("CouponOriginBooking")
  payment                 Payment?
  paymentAttempts         PaymentAttempt[]

  @@index([checkoutConfirmedAt])
  @@index([hospedinRegisteredAt])
  @@index([status, paymentDeadlineAt])
}

model PartialPaymentSettings {
  id                          String   @id
  enabled                     Boolean  @default(false)
  percentage                  Int      @default(50)
  minimumBookingAmount        Decimal?
  minimumLeadTimeDays         Int?
  balanceDueAt                String   @default("CHECK_IN")
  balanceDueDaysBeforeCheckIn Int?
  defaultPaymentMode          String   @default("FULL")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model DiscountPolicySettings {
  id                    String   @id
  sendEnabled           Boolean  @default(true)
  percentage            Int      @default(10)
  validityDays          Int      @default(7)
  minimumBookingValue   Decimal?
  maximumDiscountAmount Decimal?
  blockedDateRanges     String   @default("[]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Payment {
  id              String    @id @default(uuid())
  bookingId       String    @unique
  amount          Decimal
  totalAmount     Decimal?
  remainingAmount Decimal   @default(0)
  paymentMode     String    @default("FULL")
  balanceDueAt    String?
  balanceDueDate  DateTime?
  provider        String
  providerId      String?
  method          String?
  cardBrand       String?
  installments    Int?
  status          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  booking         Booking   @relation(fields: [bookingId], references: [id])
}

model PaymentAttempt {
  id                String   @id @default(uuid())
  bookingId         String
  provider          String
  providerPaymentId String   @unique
  amount            Decimal?
  currency          String?
  method            String?
  cardBrand         String?
  installments      Int?
  status            String
  statusDetail      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([status, createdAt])
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Coupon {
  id                 String             @id @default(uuid())
  name               String
  codeHash           String             @unique
  codePrefix         String
  codeCiphertext     String?
  type               String
  value              Decimal
  maxDiscountAmount  Decimal?
  minBookingValue    Decimal?
  active             Boolean            @default(true)
  startsAt           DateTime?
  endsAt             DateTime?
  maxGlobalUses      Int?
  maxUsesPerGuest    Int?
  bindEmail          String?
  bindPhone          String?
  originBookingId    String?
  allowedRoomTypeIds String?
  allowedSources     String?
  singleUse          Boolean            @default(false)
  stackable          Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  attemptLogs        CouponAttemptLog[]
  originBooking      Booking?           @relation("CouponOriginBooking", fields: [originBookingId], references: [id], onDelete: SetNull)
  redemptions        CouponRedemption[]

  @@index([codePrefix])
  @@index([active])
  @@index([originBookingId])
  @@index([startsAt, endsAt])
}

model CouponRedemption {
  id             String    @id @default(uuid())
  couponId       String
  status         String    @default("RESERVED")
  bookingId      String?   @unique
  guestEmail     String?
  guestPhone     String?
  discountAmount Decimal   @default(0)
  reservedAt     DateTime  @default(now())
  expiresAt      DateTime?
  confirmedAt    DateTime?
  releasedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  booking        Booking?  @relation(fields: [bookingId], references: [id])
  coupon         Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId, status])
  @@index([guestEmail, couponId])
}

model CouponAttemptLog {
  id            String   @id @default(uuid())
  couponId      String?
  codePrefix    String?
  guestEmail    String?
  ipHash        String?
  userAgentHash String?
  result        String
  reason        String?
  createdAt     DateTime @default(now())
  coupon        Coupon?  @relation(fields: [couponId], references: [id])

  @@index([createdAt])
  @@index([codePrefix])
}

model Promotion {
  id                   String    @id @default(uuid())
  name                 String
  badgeLabel           String?
  type                 String
  active               Boolean   @default(true)
  discountPercent      Decimal
  maxDiscountAmount    Decimal?
  minDaysBeforeCheckIn Int?
  maxDaysBeforeCheckIn Int?
  stayStart            DateTime?
  stayEnd              DateTime?
  bookableFrom         DateTime?
  bookableUntil        DateTime?
  minNights            Int?
  allowedRoomTypeIds   String?
  stackWithCoupons     Boolean   @default(false)
  // JSON com ids de cupons que acumulam; null = qualquer cupom compatível (quando stackWithCoupons).
  allowedCouponIds     String?
  stackWithPromotions  Boolean   @default(false)
  // JSON com ids de promoções que acumulam; null = qualquer outra (quando stackWithPromotions).
  allowedPromotionIds  String?
  exclusive            Boolean   @default(false)
  // Público da promoção: "all" (todos) ou "mobile" (só quem reserva pelo celular).
  audience             String    @default("all")
  // false = o desconto vale, mas a etiqueta/nome não aparece ao hóspede.
  showBadge            Boolean   @default(true)
  // JSON de intervalos de noites em que a promoção não vale.
  excludedStayDates    String?
  // JSON [0..6] (0 = domingo): dias da semana em que a promoção vale, noite a noite.
  daysOfWeek           String?
  // Sem uso na tela: o desempate é automático (maior desconto, depois mais recente).
  priority             Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([active])
  @@index([type])
}
