        "jsCode": "const body = $json.body ?? $json;\nconst requiredStrings = ['eventId', 'eventType', 'occurredAt', 'entityId', 'correlationId', 'causationId'];\nif (body.schemaVersion !== 1 || requiredStrings.some((key) => typeof body[key] !== 'string' || body[key].length === 0)) {\n  throw new Error('invalid_crm_event_envelope');\n}\nreturn [{ json: { accepted: true, schemaVersion: body.schemaVersion, eventId: body.eventId, eventType: body.eventType, occurredAt: body.occurredAt, entityId: body.entityId, correlationId: body.correlationId, causationId: body.causationId, resources: body.resources ?? {}, data: body.data ?? {} } }];"
      },
      "id": "validate-event-envelope",
      "name": "Validar envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-80, 0]
    },
