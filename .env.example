# Ambiente
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
BASE_URL=http://localhost:3001

# Banco local. Nunca coloque credenciais de produção neste arquivo.
DATABASE_URL=file:./prisma/dev.db
DATABASE_AUTH_TOKEN=

# Administração
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
CRM_INTERNAL_API_TOKEN=replace-with-a-long-random-token
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# Hotel
HOTEL_NAME=Pousada Delplata
HOTEL_EMAIL=hotel@example.com
HOTEL_WHATSAPP=5500000000000
HOTEL_WHATSAPP_LINK=https://wa.me/5500000000000
POUSADA_PHONE=5500000000000
CONTACT_RECEIVER_EMAIL=hotel@example.com
ALWAYS_BCC_EMAIL=

# E-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_MIN_TRANSACTION_AMOUNT=
MP_MIN_TRANSACTION_AMOUNT_PIX=
ENABLE_TEST_PAYMENTS=false
NEXT_PUBLIC_ENABLE_TEST_PAYMENTS=false
MP_TEST_PAYER_EMAIL=
NEXT_PUBLIC_MP_TEST_PAYER_EMAIL=

# Hospedin
HOSPEDIN_BASE_URL=
HOSPEDIN_ACCOUNT_ID=
HOSPEDIN_EMAIL=
HOSPEDIN_PASSWORD=

# WhatsApp atual — Evolution permanece somente até a migração para Meta.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Eventos legados. Desabilitado por padrão.
N8N_ENABLED=false
N8N_WEBHOOK_URL=

# IA opcional
OPENAI_API_KEY=
CRM_AI_INTENT_MIN_CONFIDENCE=0.8

# Analytics
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Operação
PENDING_BOOKING_TTL_MINUTES=15
CRON_SECRET=replace-with-a-long-random-token

# WhatsApp Cloud API da Meta — será ativada somente nas fases correspondentes.
WHATSAPP_PROVIDER=evolution
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
