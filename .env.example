# Banco novo desta pousada. Para desenvolvimento local, use um arquivo novo.
DATABASE_URL="file:./dev.db"
# Em produção, configure uma URL libSQL e o token somente na plataforma de deploy.
DATABASE_AUTH_TOKEN=""

# Hospedin PMS
HOSPEDIN_BASE_URL="https://pms-api.hospedin.com/api/v2"
HOSPEDIN_EMAIL=""
HOSPEDIN_PASSWORD=""
HOSPEDIN_ACCOUNT_ID=""
HOSPEDIN_SYNC_ENABLED="false"
# Segredo que autoriza /api/cron/hospedin-sync (cron da Vercel e GitHub Actions). Gere com: openssl rand -hex 32
# Em produção, defina o MESMO valor na Vercel (env) e no GitHub (Settings > Secrets > Actions).
CRON_SECRET=""
# Prazo (min) para pagar uma reserva pendente: o checkout do Asaas vence nesse horário.
PENDING_BOOKING_PAYMENT_WINDOW_MINUTES="60"
# Folga (min) em que o quarto continua bloqueado depois que o link vence (Pix vence prazo + 30 min).
PENDING_BOOKING_HOLD_GRACE_MINUTES="60"

# Marca e URLs públicas
HOTEL_NAME="Nome da Pousada"
HOTEL_EMAIL="reservas@example.com"
HOTEL_WHATSAPP="5511999999999"
HOTEL_WHATSAPP_LINK="https://wa.me/5511999999999"
NEXT_PUBLIC_HOTEL_WHATSAPP="5511999999999"
NEXT_PUBLIC_HOTEL_WHATSAPP_LINK="https://wa.me/5511999999999"
NEXT_PUBLIC_SITE_URL="http://localhost:3005"
NEXT_PUBLIC_BASE_URL="http://localhost:3005"

# Administração: crie segredos novos e longos para cada pousada.
ADMIN_JWT_SECRET="substitua-por-um-segredo-aleatorio-novo"
BOOKING_ACCESS_SECRET="substitua-por-um-segredo-independente-e-aleatorio"
ADMIN_BOOTSTRAP_SECRET="substitua-por-outro-segredo-aleatorio-novo"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="troque-esta-senha-antes-de-publicar"

# Mercado Pago (legado): mantido para o webhook de pagamentos antigos (estornos/chargebacks).
# Mercado Pago: nunca reutilize tokens de outra pousada.
NEXT_PUBLIC_MP_PUBLIC_KEY="TEST-sua-chave-publica"
MP_ACCESS_TOKEN="TEST-seu-token-de-acesso"
MP_WEBHOOK_SECRET="crie-um-segredo-para-o-webhook"

# Asaas (pagamento das reservas novas). Só no servidor; nunca reutilize chave de outra pousada.
# Em produção: ASAAS_ENVIRONMENT="production". O build da Vercel falha se faltar algum destes.
# O webhook do Asaas deve apontar para https://<dominio>/api/webhooks/asaas com o MESMO token.
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN="crie-um-segredo-longo-para-o-webhook-do-asaas"
ASAAS_ENVIRONMENT="sandbox"

# E-mail transacional
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="usuario@example.com"
SMTP_PASS="substitua-por-senha-ou-chave-de-app"
CONTACT_RECEIVER_EMAIL="reservas@example.com"

# Opcionais
SENTRY_DSN=""
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
ENABLE_TEST_PAYMENTS="false"
NEXT_PUBLIC_ENABLE_TEST_PAYMENTS="false"
PIX_DISCOUNT_ENABLED="false"
